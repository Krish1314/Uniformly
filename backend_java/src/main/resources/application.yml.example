server:
  port: 8080

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/uniformly_db
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration

application:
  security:
    jwt:
      secret-key: YOUR_JWT_SECRET_KEY_HERE
      expiration: 86400000 # 1 day in ms
